#!/usr/bin/env bash
# Dump via the real deckard CLI (spec acceptance criteria 18.1/18.2).
#
#   bin/dump "Comment.all" > stream.dump
set -euo pipefail

if [[ "${DECKARD_HARNESS_BOOT_LOG:-}" == "1" ]]; then
  echo "application booted"
fi

target="$1"
shift
exec bundle exec deckard -r ./config/environment -d "$target" "$@"
